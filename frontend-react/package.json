{
  "name": "nutricionista-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:clinical": "tsc -b && vite build --mode clinical",
    "build:control-plane": "tsc -b && vite build --mode control-plane",
    "typecheck": "tsc -b --pretty false",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:e2e:ci": "playwright test --project=chromium",
    "test:e2e:ui": "playwright test --ui",
    "verify": "npm --prefix ../backend-node test && npm --prefix ../backend-node run typecheck && npm run typecheck && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-router-dom": "latest"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "typescript": "latest",
    "vite": "latest"
  }
}
