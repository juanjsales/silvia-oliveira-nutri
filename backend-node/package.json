{
  "name": "nutricionista-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test tests/**/*.test.ts",
    "db:migrate": "tsx src/database/migrate.ts",
    "db:status": "tsx src/database/status.ts",
    "admin:create": "tsx src/scripts/create-admin.ts",
    "platform-admin:grant": "tsx src/scripts/grant-platform-admin.ts",
    "catalogs:import": "tsx src/scripts/import-legacy-catalogs.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.1.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "argon2": "^0.44.0",
    "fastify": "^5.6.0",
    "nodemailer": "^9.0.5",
    "pg": "^8.16.3",
    "web-push": "^3.6.7",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/nodemailer": "^7.0.1",
    "@types/pg": "^8.15.5",
    "@types/web-push": "^3.6.4",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
