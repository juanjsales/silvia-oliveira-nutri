# Exemplo seguro: copie os nomes para o ambiente Preview/Staging da hospedagem.
# Nunca reutilize valores, projeto Supabase ou domínio da clínica em produção.
NODE_ENV=production
DEPLOYMENT_ENVIRONMENT=staging
STAGING_INSTANCE_ID=product-staging
DATABASE_ENVIRONMENT_ID=product-staging-db
# IDs reais são usados somente como lista de bloqueio; não são credenciais.
PROTECTED_PRODUCTION_PROJECT_ID=INFORME_O_ID_DO_PROJETO_REAL_PARA_BLOQUEIO
PROTECTED_PRODUCTION_DATABASE_ID=INFORME_O_ID_DO_BANCO_REAL_PARA_BLOQUEIO
# Mantenha false. Habilite apenas durante uma operação externa deliberada e auditada.
ALLOW_EXTERNAL_PROVIDER_PROVISIONING=false
# Terceiro opt-in, efêmero e vinculado à operação. Ex.: staging:uuid-da-operacao
PROVIDER_EXECUTION_CONFIRMATION=
# Chave pública da central (não é segredo) e identidade única desta instalação.
LICENSE_PUBLIC_KEY=COLE_A_CHAVE_PUBLICA_PEM_DA_CENTRAL
INSTALLATION_ID=tenant-demo-staging
DATABASE_URL=postgresql://STAGING_USER:STAGING_PASSWORD@STAGING_POOLER_HOST:6543/postgres?sslmode=verify-full
MIGRATION_DATABASE_URL=postgresql://STAGING_USER:STAGING_PASSWORD@STAGING_DB_HOST:5432/postgres?sslmode=verify-full
FRONTEND_ORIGIN=https://SEU-PROJETO-STAGING.vercel.app
APP_URL=https://SEU-PROJETO-STAGING.vercel.app
SESSION_COOKIE_NAME=nutri_staging_session
SMTP_FROM=Homologação Nutri <staging@example.com>
APP_ENCRYPTION_KEY=GERE_UM_SEGREDO_EXCLUSIVO_COM_32_OU_MAIS_CARACTERES
CRON_SECRET=GERE_OUTRO_SEGREDO_EXCLUSIVO_COM_32_OU_MAIS_CARACTERES
