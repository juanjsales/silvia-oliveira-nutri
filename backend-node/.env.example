NODE_ENV=development
PORT=3000
HOST=127.0.0.1
DATABASE_URL=postgresql://USER:PASSWORD@TRANSACTION_POOLER_HOST:6543/postgres?sslmode=verify-full
MIGRATION_DATABASE_URL=postgresql://USER:PASSWORD@MIGRATION_HOST:5432/postgres?sslmode=verify-full
DB_POOL_MAX=2
DB_CONNECTION_TIMEOUT_MS=10000
DB_IDLE_TIMEOUT_MS=10000

# ⚠️ FRONTEND_ORIGIN É CRÍTICO PARA CORS E LOGIN NO VERCEL
# Local: use http://localhost:5173
# Vercel: use https://seu-projeto.vercel.app (exatamente como aparece na navegador)
FRONTEND_ORIGIN=http://localhost:5173
APP_URL=http://localhost:5173
# Jitsi as a Service (JaaS). A chave privada aceita quebras de linha como \\n.
JAAS_APP_ID=vpaas-magic-cookie-SEU_APP_ID
JAAS_KEY_ID=SEU_KEY_ID
JAAS_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nSUA_CHAVE\n-----END PRIVATE KEY-----
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_EXAMS_BUCKET=patient-exams
SESSION_COOKIE_NAME=nutri_session
SESSION_TTL_HOURS=6
PASSWORD_RESET_TTL_MINUTES=30
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
APP_ENCRYPTION_KEY=generate-a-random-key-with-at-least-32-characters
CRON_SECRET=generate-another-random-secret-with-at-least-32-characters
# STUN pode conter múltiplas URLs separadas por vírgula. TURN é opcional e deve
# usar credenciais de curta duração, injetadas pelo provedor e rotacionadas.
WEBRTC_STUN_URLS=stun:stun.l.google.com:19302
# WEBRTC_TURN_URL=turns:turn.example.com:5349
# WEBRTC_TURN_USERNAME=
# WEBRTC_TURN_CREDENTIAL=
# Recomendado em produção: servidor PeerJS próprio ou gerenciado. Se omitido,
# o cliente usa explicitamente o serviço público padrão apenas como fallback.
# WEBRTC_SIGNALING_HOST=peer.example.com
# WEBRTC_SIGNALING_PORT=443
# WEBRTC_SIGNALING_PATH=/peerjs
# WEBRTC_SIGNALING_SECURE=true
SMTP_FROM=Consultório Nutricional <contato@example.com>
