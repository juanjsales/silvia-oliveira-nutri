{
  "name": "kos-nutri-platform",
  "private": true,
  "type": "module",
  "workspaces": ["frontend-react", "backend-node"],
  "scripts": {
    "build": "npm --workspace frontend-react run build",
    "release:preflight": "node scripts/release-preflight.mjs",
    "deploy:policy": "node scripts/validate-deployment-policy.mjs",
    "staging:env": "node scripts/validate-staging-env.mjs",
    "release:env": "node scripts/validate-production-env.mjs",
    "test:release": "node --test scripts/*.test.mjs",
    "artifact:clinical": "node scripts/clinical-artifact-release.mjs",
    "push:keys": "node scripts/generate-vapid-keys.mjs",
    "typecheck": "npm --workspace backend-node run typecheck && npm --workspace frontend-react run typecheck",
    "test": "npm --workspace backend-node test",
    "check": "npm run deploy:policy && npm run release:preflight && npm run test:release && npm run typecheck && npm run test && npm run build && npm --workspace backend-node run build"
  },
  "engines": { "node": "22.x" }
}
