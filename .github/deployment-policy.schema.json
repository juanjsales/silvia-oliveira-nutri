{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["canonicalProduction", "product"],
  "properties": {
    "canonicalProduction": {
      "type": "object",
      "required": ["branch", "environment", "owner", "host", "automaticPromotion"]
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": ["branch", "allowedEnvironments", "canonicalProductionPromotion", "productionDatabaseAccess", "requiredEnvironmentMarker", "forbiddenIdentifiers"],
      "properties": {
        "branch": { "type": "string" },
        "allowedEnvironments": { "type": "array", "minItems": 1, "items": { "enum": ["preview", "staging"] } },
        "canonicalProductionPromotion": { "const": "forbidden" },
        "productionDatabaseAccess": { "const": "forbidden" },
        "requiredEnvironmentMarker": { "const": "staging" },
        "forbiddenIdentifiers": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
